
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F3F6FB"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="QUEUE SIMULATION"
            android:textColor="#173B67"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="28dp"
            android:gravity="center"
            android:text="Customer Arrival and Service System"
            android:textColor="#64748B"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Simulation Settings"
            android:textColor="#173B67"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="Number of Customers"
            android:textColor="#334155"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/customerCountEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter number of customers"
            android:inputType="number"
            android:minHeight="52dp"
            android:padding="12dp"
            android:backgroundTint="#2563EB"
            android:layout_marginBottom="18dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="Simulation Duration (minutes)"
            android:textColor="#334155"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/durationEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter duration in minutes"
            android:inputType="numberDecimal"
            android:minHeight="52dp"
            android:padding="12dp"
            android:backgroundTint="#2563EB"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/startSimulationButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:backgroundTint="#173B67"
            android:text="Start Simulation"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="12dp"
            android:text="Simulation Results"
            android:textColor="#173B67"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/resultsTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:gravity="center_vertical"
            android:minHeight="100dp"
            android:padding="16dp"
            android:text="Your simulation results will appear here."
            android:textColor="#475569"
            android:textSize="15sp" />

    </LinearLayout>

</ScrollView>
